<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>NexCore — GitHub Uploader</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0d1117;color:#e6edf3;font-family:-apple-system,system-ui,sans-serif;padding:16px;min-height:100vh}
h1{font-size:20px;font-weight:700;color:#58a6ff;margin-bottom:4px}
.sub{font-size:12px;color:#8b949e;margin-bottom:20px}
label{display:block;font-size:12px;color:#8b949e;margin-bottom:5px;margin-top:14px}
input{width:100%;padding:10px 12px;background:#161b22;border:1px solid #30363d;border-radius:6px;color:#e6edf3;font-size:14px;outline:none}
input:focus{border-color:#58a6ff}
.hint{font-size:11px;color:#8b949e;margin-top:4px}
.hint a{color:#58a6ff;text-decoration:none}
button{width:100%;margin-top:18px;padding:12px;background:#238636;border:none;border-radius:6px;color:#fff;font-size:15px;font-weight:600;cursor:pointer}
button:disabled{background:#21262d;color:#8b949e;cursor:not-allowed}
#log{margin-top:16px;background:#161b22;border:1px solid #30363d;border-radius:6px;padding:12px;font-family:monospace;font-size:11px;line-height:1.8;max-height:320px;overflow-y:auto;display:none}
.ok{color:#3fb950}.err{color:#f85149}.info{color:#58a6ff}.warn{color:#d29922}
#progress{display:none;margin-top:12px}
.bar-bg{background:#21262d;border-radius:4px;height:8px;overflow:hidden}
.bar-fill{height:100%;background:#238636;border-radius:4px;transition:width .3s;width:0%}
.bar-label{font-size:12px;color:#8b949e;margin-top:5px;text-align:center}
#result{display:none;margin-top:14px;padding:14px;border-radius:6px;font-size:13px;text-align:center}
.success{background:#0d2817;border:1px solid #238636;color:#3fb950}
.failed{background:#2d1117;border:1px solid #da3633;color:#f85149}
</style>
</head>
<body>
<h1>NexCore Uploader</h1>
<div class="sub">Upload 23 file source code ke GitHub secara otomatis</div>

<label>GitHub Personal Access Token</label>
<input type="password" id="token" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx">
<div class="hint">Buat di: <a href="https://github.com/settings/tokens/new" target="_blank">github.com/settings/tokens/new</a> → centang <b>repo</b> → Generate token</div>

<label>Username GitHub</label>
<input type="text" id="owner" placeholder="falllstok8-glitch">

<label>Nama Repository</label>
<input type="text" id="repo" value="nexcore">

<button id="btn" onclick="startUpload()">⬆ Upload Semua File (23 files)</button>

<div id="progress">
  <div class="bar-bg"><div class="bar-fill" id="bar"></div></div>
  <div class="bar-label" id="bar-label">0 / 23</div>
</div>

<div id="result"></div>
<div id="log"></div>

<script>
const FILES = [{"path": "build.gradle", "content": "plugins {\n    id(\"com.android.application\") version \"8.3.1\" apply false\n    id(\"org.jetbrains.kotlin.android\") version \"1.9.23\" apply false\n    id(\"org.jetbrains.kotlin.plugin.compose\") version \"1.9.23\" apply false\n    id(\"com.google.devtools.ksp\") version \"1.9.23-1.0.19\" apply false\n}"}, {"path": "settings.gradle", "content": "pluginManagement {\n    repositories { google(); mavenCentral(); gradlePluginPortal() }\n}\ndependencyResolutionManagement {\n    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)\n    repositories {\n        google(); mavenCentral()\n        maven { url = uri(\"https://jitpack.io\") }\n    }\n}\nrootProject.name = \"NexCore\"\ninclude(\":app\")"}, {"path": "app/build.gradle", "content": "plugins {\n    id(\"com.android.application\")\n    id(\"org.jetbrains.kotlin.android\")\n    id(\"org.jetbrains.kotlin.plugin.compose\")\n    id(\"com.google.devtools.ksp\")\n}\n\nandroid {\n    namespace = \"com.nexcore.optimizer\"\n    compileSdk = 34\n\n    defaultConfig {\n        applicationId = \"com.nexcore.optimizer\"\n        minSdk = 26\n        targetSdk = 34\n        versionCode = 1\n        versionName = \"2.4.1\"\n    }\n\n    buildTypes {\n        release {\n            isMinifyEnabled = true\n            proguardFiles(\n                getDefaultProguardFile(\"proguard-android-optimize.txt\"),\n                \"proguard-rules.pro\"\n            )\n        }\n    }\n\n    compileOptions {\n        sourceCompatibility = JavaVersion.VERSION_17\n        targetCompatibility = JavaVersion.VERSION_17\n    }\n    kotlinOptions { jvmTarget = \"17\" }\n    buildFeatures {\n        compose = true\n        aidl  = true\n    }\n}\n\ndependencies {\n    val composeBom = platform(\"androidx.compose:compose-bom:2024.04.01\")\n    implementation(composeBom)\n    implementation(\"androidx.compose.ui:ui\")\n    implementation(\"androidx.compose.ui:ui-tooling-preview\")\n    implementation(\"androidx.compose.material3:material3\")\n    implementation(\"androidx.activity:activity-compose:1.9.0\")\n    implementation(\"androidx.navigation:navigation-compose:2.7.7\")\n    implementation(\"androidx.lifecycle:lifecycle-viewmodel-compose:2.7.0\")\n    implementation(\"androidx.lifecycle:lifecycle-runtime-ktx:2.7.0\")\n\n    // Shizuku \u2014 privileged API access without root\n    implementation(\"dev.rikka.shizuku:api:13.1.5\")\n    implementation(\"dev.rikka.shizuku:provider:13.1.5\")\n\n    // Coroutines\n    implementation(\"org.jetbrains.kotlinx:kotlinx-coroutines-android:1.8.0\")\n\n    // DataStore \u2014 persist profiles\n    implementation(\"androidx.datastore:datastore-preferences:1.1.1\")\n\n    // Room \u2014 session history\n    implementation(\"androidx.room:room-runtime:2.6.1\")\n    implementation(\"androidx.room:room-ktx:2.6.1\")\n    ksp(\"androidx.room:room-compiler:2.6.1\")\n\n    // JSON\n    implementation(\"com.squareup.moshi:moshi-kotlin:1.15.1\")\n\n    debugImplementation(\"androidx.compose.ui:ui-tooling\")\n}"}, {"path": "app/src/main/AndroidManifest.xml", "content": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:tools=\"http://schemas.android.com/tools\">\n\n    <queries>\n        <package android:name=\"moe.shizuku.privileged.api\" />\n    </queries>\n\n    <uses-permission android:name=\"android.permission.WRITE_SETTINGS\" />\n    <uses-permission android:name=\"android.permission.WRITE_SECURE_SETTINGS\" />\n    <uses-permission android:name=\"android.permission.PACKAGE_USAGE_STATS\"\n        tools:ignore=\"ProtectedPermissions\" />\n    <uses-permission android:name=\"android.permission.QUERY_ALL_PACKAGES\"\n        tools:ignore=\"QueryAllPackagesPermission\" />\n    <uses-permission android:name=\"android.permission.FOREGROUND_SERVICE\" />\n    <uses-permission android:name=\"android.permission.FOREGROUND_SERVICE_DATA_SYNC\" />\n    <uses-permission android:name=\"android.permission.RECEIVE_BOOT_COMPLETED\" />\n    <uses-permission android:name=\"android.permission.INTERNET\" />\n    <uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\" />\n    <uses-permission android:name=\"android.permission.CHANGE_NETWORK_STATE\" />\n    <uses-permission android:name=\"android.permission.VIBRATE\" />\n\n    <application\n        android:label=\"@string/app_name\"\n        android:allowBackup=\"false\"\n        android:supportsRtl=\"true\"\n        android:theme=\"@style/Theme.NexCore\">\n\n        <provider\n            android:name=\"rikka.shizuku.ShizukuProvider\"\n            android:authorities=\"${applicationId}.shizuku\"\n            android:exported=\"true\"\n            android:multiprocess=\"false\"\n            android:enabled=\"true\"\n            android:permission=\"android.permission.INTERACT_ACROSS_USERS_FULL\" />\n\n        <activity\n            android:name=\".MainActivity\"\n            android:exported=\"true\"\n            android:windowSoftInputMode=\"adjustResize\">\n            <intent-filter>\n                <action android:name=\"android.intent.action.MAIN\" />\n                <category android:name=\"android.intent.category.LAUNCHER\" />\n            </intent-filter>\n        </activity>\n\n        <service\n            android:name=\".service.GameDetectorService\"\n            android:exported=\"false\"\n            android:foregroundServiceType=\"dataSync\" />\n\n        <service\n            android:name=\".service.NexCoreUserService\"\n            android:exported=\"false\"\n            android:process=\":service\" />\n\n    </application>\n</manifest>"}, {"path": ".github/workflows/build.yml", "content": "name: Build NexCore APK\n\non:\n  push:\n    branches: [ main, master ]\n  workflow_dispatch:          # tombol \"Run workflow\" manual di GitHub UI\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v4\n\n      - name: Set up JDK 17\n        uses: actions/setup-java@v4\n        with:\n          java-version: '17'\n          distribution: 'temurin'\n          cache: gradle\n\n      - name: Setup Gradle 8.6\n        uses: gradle/actions/setup-gradle@v3\n        with:\n          gradle-version: \"8.6\"\n\n      - name: Point to Android SDK (already on runner)\n        run: echo \"sdk.dir=/usr/local/lib/android/sdk\" > local.properties\n\n      - name: Build debug APK\n        run: gradle assembleDebug --no-daemon --stacktrace\n\n      - name: Upload APK artifact\n        uses: actions/upload-artifact@v4\n        with:\n          name: NexCore-debug-${{ github.run_number }}\n          path: app/build/outputs/apk/debug/*.apk\n          retention-days: 30"}, {"path": "app/src/main/res/values/strings.xml", "content": "<resources>\n    <string name=\"app_name\">NexCore</string>\n</resources>"}, {"path": "app/src/main/res/values/themes.xml", "content": "<resources>\n    <!-- Base theme: Compose Material3 replaces this at runtime.\n         This entry is required so the manifest reference resolves at build time. -->\n    <style name=\"Theme.NexCore\" parent=\"android:Theme.Material.NoTitleBar\" />\n</resources>"}, {"path": "app/src/main/aidl/com/nexcore/optimizer/service/IUserService.aidl", "content": "// AIDL interface exposed by the Shizuku UserService.\n// Runs in a process with shell UID (uid=2000); has access to\n// restricted APIs unavailable to normal app processes.\npackage com.nexcore.optimizer.service;\n\ninterface IUserService {\n    /** Execute a shell command as uid=2000 (shell), return stdout. */\n    String executeCommand(String cmd);\n\n    /** Read a file readable by shell but not by the app process (e.g. /proc/). */\n    String readFile(String path);\n\n    /** Write content to a file writable by shell. */\n    boolean writeFile(String path, String content);\n\n    void destroy();\n}"}, {"path": "README.md", "content": "# NexCore Gaming Optimizer\n\nAndroid gaming optimizer \u2014 Shizuku-based, no root required.\n\n## Features\nSmartScan \u00b7 DeviceDNA \u00b7 AdaptivePerformance \u00b7 ThermalGuardian \u00b7\nNetworkIntelligence \u00b7 SensitivityManager (X/Y/smooth/deadzone) \u00b7\nSmartDPI \u00b7 NeuralEngine \u00b7 Aftermatch \u00b7 Blackbox\n\n## Build via GitHub Actions (no Android Studio needed)\n\n### 1. Buat repository GitHub\n1. Buka https://github.com \u2192 klik **New repository**\n2. Nama: `nexcore` \u2192 klik **Create repository**\n\n### 2. Upload semua file\nCara termudah \u2014 drag & drop di browser:\n1. Di halaman repo kosong klik **uploading an existing file**\n2. Drag seluruh folder `nexcore/` ke area upload\n3. Klik **Commit changes**\n\nAtau pakai Git CLI:\n```bash\ncd nexcore\ngit init\ngit remote add origin https://github.com/NAMAUSER/nexcore.git\ngit add .\ngit commit -m \"init\"\ngit push -u origin main\n```\n\n### 3. Jalankan build\n- Buka tab **Actions** di repo GitHub\n- Klik workflow **Build NexCore APK**\n- Klik **Run workflow** \u2192 **Run workflow**\n- Tunggu ~3-5 menit\n\n### 4. Download APK\n- Setelah build hijau \u2713, klik nama run-nya\n- Scroll ke bawah \u2192 **Artifacts**\n- Download `NexCore-debug-N.zip` \u2192 extract \u2192 install `.apk`\n\n## Setup di HP setelah install\n\n### Izin wajib (manual)\n```\nSettings \u2192 Apps \u2192 Special app access \u2192 Usage access \u2192 NexCore \u2192 Allow\n```\nTanpa ini GameDetectorService tidak bisa deteksi game foreground.\n\n### Aktifkan Shizuku\nInstall Shizuku dari Play Store, lalu:\n```bash\n# PC/Mac dengan USB debugging aktif:\nadb shell sh /sdcard/Android/data/moe.shizuku.privileged.api/start.sh\n```\nAtau pakai Wireless debugging di Android 11+.\n\n## Struktur project\n```\napp/src/main/\n\u251c\u2500\u2500 aidl/   IUserService.aidl          \u2014 Shizuku IPC interface\n\u251c\u2500\u2500 java/com/nexcore/optimizer/\n\u2502   \u251c\u2500\u2500 MainActivity.kt                \u2014 Compose UI entry point\n\u2502   \u251c\u2500\u2500 core/\n\u2502   \u2502   \u251c\u2500\u2500 Blackbox.kt                \u2014 Thread-safe logger + StateFlow\n\u2502   \u2502   \u251c\u2500\u2500 ShizukuManager.kt          \u2014 Shizuku binder lifecycle\n\u2502   \u2502   \u251c\u2500\u2500 SmartScan.kt               \u2014 /proc + /sys device scan\n\u2502   \u2502   \u251c\u2500\u2500 DeviceDNA.kt               \u2014 Device fingerprint + score\n\u2502   \u2502   \u251c\u2500\u2500 AdaptivePerformance.kt     \u2014 CPU/GPU governor control\n\u2502   \u2502   \u251c\u2500\u2500 ThermalGuardian.kt         \u2014 Thermal zone polling + action\n\u2502   \u2502   \u251c\u2500\u2500 NetworkIntelligence.kt     \u2014 Ping, WiFi lock, DNS\n\u2502   \u2502   \u251c\u2500\u2500 SensitivityManager.kt      \u2014 X/Y/smooth/deadzone/ptrspeed\n\u2502   \u2502   \u251c\u2500\u2500 SmartDPI.kt                \u2014 wm density via Shizuku\n\u2502   \u2502   \u251c\u2500\u2500 NeuralEngine.kt            \u2014 Scoring + recommendation\n\u2502   \u2502   \u2514\u2500\u2500 Aftermatch.kt              \u2014 Session telemetry recorder\n\u2502   \u2514\u2500\u2500 service/\n\u2502       \u251c\u2500\u2500 NexCoreUserService.kt      \u2014 Shizuku UserService (uid=2000)\n\u2502       \u2514\u2500\u2500 GameDetectorService.kt     \u2014 Foreground game detector\n\u2514\u2500\u2500 res/\n```\n\n## Minimum requirements\n- Android 8.0 (API 26)+\n- Shizuku 13.x\n- PACKAGE_USAGE_STATS permission\n\n## License\nMIT"}, {"path": "app/src/main/java/com/nexcore/optimizer/MainActivity.kt", "content": "package com.nexcore.optimizer\n\nimport android.content.Intent\nimport android.os.Bundle\nimport androidx.activity.ComponentActivity\nimport androidx.activity.compose.setContent\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.clickable\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.lazy.LazyColumn\nimport androidx.compose.foundation.lazy.items\nimport androidx.compose.foundation.shape.CircleShape\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.material3.*\nimport androidx.compose.material3.TabRowDefaults.tabIndicatorOffset\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.draw.clip\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.text.font.FontFamily\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport androidx.lifecycle.compose.collectAsStateWithLifecycle\nimport com.nexcore.optimizer.core.*\nimport com.nexcore.optimizer.service.GameDetectorService\nimport kotlinx.coroutines.launch\n\nclass MainActivity : ComponentActivity() {\n\n    private lateinit var shizuku   : ShizukuManager\n    private lateinit var scan      : SmartScan\n    private lateinit var dnaBld    : DeviceDNA\n    private lateinit var perf      : AdaptivePerformance\n    private lateinit var thermal   : ThermalGuardian\n    private lateinit var sensi     : SensitivityManager\n    private lateinit var smartDpi  : SmartDPI\n    private lateinit var net       : NetworkIntelligence\n    private lateinit var aftermatch: Aftermatch\n    private lateinit var neural    : NeuralEngine\n\n    override fun onCreate(savedInstanceState: Bundle?) {\n        super.onCreate(savedInstanceState)\n\n        // Init core layer\n        shizuku    = ShizukuManager(this).also { it.init() }\n        perf       = AdaptivePerformance(shizuku)\n        scan       = SmartScan(this, shizuku)\n        dnaBld     = DeviceDNA(scan)\n        thermal    = ThermalGuardian(this, shizuku, perf).also { it.start() }\n        net        = NetworkIntelligence(this, shizuku)\n        sensi      = SensitivityManager(this, shizuku)\n        smartDpi   = SmartDPI(this, shizuku)\n        aftermatch = Aftermatch()\n        neural     = NeuralEngine(perf, thermal, net, dnaBld).also {\n            it.init(dnaBld.build())\n        }\n\n        // Start background game detector\n        startForegroundService(Intent(this, GameDetectorService::class.java))\n\n        setContent {\n            MaterialTheme(\n                colorScheme = darkColorScheme(\n                    primary        = Color(0xFF00E5A0),\n                    background     = Color(0xFF080810),\n                    surface        = Color(0xFF10121E),\n                    onBackground   = Color(0xFFE8EAF6),\n                    onSurface      = Color(0xFFE8EAF6),\n                )\n            ) {\n                NexCoreApp(\n                    shizuku    = shizuku,\n                    perf       = perf,\n                    thermal    = thermal,\n                    sensi      = sensi,\n                    smartDpi   = smartDpi,\n                    net        = net,\n                    aftermatch = aftermatch,\n                    neural     = neural\n                )\n            }\n        }\n    }\n\n    override fun onDestroy() {\n        shizuku.destroy()\n        super.onDestroy()\n    }\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Root composable\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n@Composable\nfun NexCoreApp(\n    shizuku   : ShizukuManager,\n    perf      : AdaptivePerformance,\n    thermal   : ThermalGuardian,\n    sensi     : SensitivityManager,\n    smartDpi  : SmartDPI,\n    net       : NetworkIntelligence,\n    aftermatch: Aftermatch,\n    neural    : NeuralEngine\n) {\n    val tabs = listOf(\"Dashboard\", \"Sensi & DPI\", \"Games\", \"Aftermatch\", \"Blackbox\")\n    var selectedTab by remember { mutableIntStateOf(0) }\n\n    val shizukuOk   by shizuku.connected.collectAsStateWithLifecycle()\n    val thermalState by thermal.state.collectAsStateWithLifecycle()\n    val neuralScore  by neural.score.collectAsStateWithLifecycle()\n    val logEntries   by Blackbox.flow.collectAsStateWithLifecycle()\n    val sessions     by aftermatch.history.collectAsStateWithLifecycle()\n\n    val accent = Color(0xFF00E5A0)\n    val warn   = Color(0xFFFFB800)\n    val danger = Color(0xFFFF4B6E)\n    val muted  = Color(0xFF6B7290)\n    val card   = Color(0xFF141628)\n\n    Scaffold(\n        containerColor = Color(0xFF080810),\n        topBar = {\n            Column(Modifier.padding(horizontal = 16.dp, vertical = 12.dp)) {\n                Row(\n                    Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Column {\n                        Text(\"NexCore\", fontSize = 20.sp, fontWeight = FontWeight.Bold, color = accent)\n                        Text(\"Gaming Optimizer v2.4\", fontSize = 11.sp, color = muted)\n                    }\n                    // Shizuku badge\n                    Surface(\n                        shape = RoundedCornerShape(20.dp),\n                        color = if (shizukuOk) Color(0x2200E5A0) else Color(0x22FF4B6E),\n                        border = ButtonDefaults.outlinedButtonBorder\n                    ) {\n                        Row(\n                            Modifier.padding(horizontal = 10.dp, vertical = 5.dp),\n                            verticalAlignment = Alignment.CenterVertically,\n                            horizontalArrangement = Arrangement.spacedBy(5.dp)\n                        ) {\n                            Box(\n                                Modifier.size(6.dp).clip(CircleShape)\n                                    .background(if (shizukuOk) accent else danger)\n                            )\n                            Text(\n                                if (shizukuOk) \"Shizuku active\" else \"Shizuku offline\",\n                                fontSize = 11.sp,\n                                color = if (shizukuOk) accent else danger\n                            )\n                        }\n                    }\n                }\n                Spacer(Modifier.height(10.dp))\n                ScrollableTabRow(\n                    selectedTabIndex = selectedTab,\n                    containerColor   = Color.Transparent,\n                    contentColor     = accent,\n                    edgePadding      = 0.dp\n                ) {\n                    tabs.forEachIndexed { i, t ->\n                        Tab(\n                            selected = selectedTab == i,\n                            onClick  = { selectedTab = i },\n                            text     = { Text(t, fontSize = 13.sp, fontWeight = if (selectedTab==i) FontWeight.Bold else FontWeight.Normal) }\n                        )\n                    }\n                }\n            }\n        }\n    ) { pad ->\n        Box(Modifier.padding(pad).fillMaxSize()) {\n            when (selectedTab) {\n                0 -> DashboardTab(thermal, thermalState, neuralScore, accent, warn, danger, muted, card, perf, shizukuOk)\n                1 -> SensiDpiTab(sensi, smartDpi, accent, muted, card)\n                2 -> GamesTab(accent, muted, card)\n                3 -> AftermatchTab(sessions, accent, warn, danger, muted, card)\n                4 -> BlackboxTab(logEntries, accent, warn, danger, muted)\n            }\n        }\n    }\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Dashboard\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n@Composable\nfun DashboardTab(\n    thermal     : ThermalGuardian,\n    thermalState: ThermalGuardian.State,\n    neuralScore : Int,\n    accent: Color, warn: Color, danger: Color, muted: Color, card: Color,\n    perf        : AdaptivePerformance,\n    shizukuOk   : Boolean\n) {\n    val scope = rememberCoroutineScope()\n    val readings by thermal.readings.collectAsStateWithLifecycle()\n    val cpuTemp = readings.firstOrNull { \"cpu\" in it.zoneName.lowercase() }?.tempC ?: 0f\n\n    LazyColumn(\n        Modifier.fillMaxSize().padding(horizontal = 16.dp),\n        verticalArrangement = Arrangement.spacedBy(10.dp),\n        contentPadding = PaddingValues(vertical = 12.dp)\n    ) {\n        // Neural score\n        item {\n            NexCard(card) {\n                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {\n                    Column {\n                        Text(\"Neural score\", fontSize = 11.sp, color = muted)\n                        Text(\"$neuralScore / 100\", fontSize = 28.sp, fontWeight = FontWeight.Bold, color = accent)\n                    }\n                    Text(thermalState.name, fontSize = 12.sp, color = when (thermalState) {\n                        ThermalGuardian.State.NORMAL   -> accent\n                        ThermalGuardian.State.WARM     -> warn\n                        ThermalGuardian.State.HOT      -> warn\n                        ThermalGuardian.State.CRITICAL -> danger\n                    })\n                }\n            }\n        }\n\n        // Thermal readings\n        item {\n            NexCard(card) {\n                Text(\"Thermal Guardian\", fontSize = 13.sp, fontWeight = FontWeight.SemiBold, color = Color(0xFFE8EAF6))\n                Spacer(Modifier.height(10.dp))\n                readings.take(4).forEach { r ->\n                    Row(Modifier.fillMaxWidth().padding(vertical = 3.dp), horizontalArrangement = Arrangement.SpaceBetween) {\n                        Text(r.zoneName, fontSize = 12.sp, color = muted)\n                        Text(\"%.1f\u00b0C\".format(r.tempC), fontSize = 12.sp, color = if (r.tempC > 50f) danger else if (r.tempC > 42f) warn else accent)\n                    }\n                    LinearProgressIndicator(\n                        progress = { (r.tempC / 60f).coerceIn(0f, 1f) },\n                        modifier = Modifier.fillMaxWidth().height(3.dp).clip(RoundedCornerShape(2.dp)),\n                        color    = if (r.tempC > 50f) danger else if (r.tempC > 42f) warn else accent,\n                        trackColor = Color(0x1AFFFFFF)\n                    )\n                    Spacer(Modifier.height(6.dp))\n                }\n            }\n        }\n\n        // Performance buttons\n        item {\n            NexCard(card) {\n                Text(\"Adaptive Performance\", fontSize = 13.sp, fontWeight = FontWeight.SemiBold, color = Color(0xFFE8EAF6))\n                Spacer(Modifier.height(10.dp))\n                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n                    AdaptivePerformance.Profile.entries.forEach { p ->\n                        OutlinedButton(\n                            onClick = { scope.launch { perf.apply(p) } },\n                            modifier = Modifier.weight(1f),\n                            enabled  = shizukuOk,\n                            colors   = ButtonDefaults.outlinedButtonColors(contentColor = accent)\n                        ) { Text(p.name.take(4), fontSize = 10.sp) }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Sensi & DPI\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n@Composable\nfun SensiDpiTab(sensi: SensitivityManager, smartDpi: SmartDPI, accent: Color, muted: Color, card: Color) {\n    val scope = rememberCoroutineScope()\n    var sensiX    by remember { mutableFloatStateOf(1.6f) }\n    var sensiY    by remember { mutableFloatStateOf(1.6f) }\n    var smooth    by remember { mutableFloatStateOf(0.75f) }\n    var deadzone  by remember { mutableIntStateOf(2) }\n    var ptrSpeed  by remember { mutableIntStateOf(3) }\n    var dpiValue  by remember { mutableIntStateOf(240) }\n\n    LazyColumn(\n        Modifier.fillMaxSize().padding(horizontal = 16.dp),\n        verticalArrangement = Arrangement.spacedBy(10.dp),\n        contentPadding = PaddingValues(vertical = 12.dp)\n    ) {\n        item {\n            NexCard(card) {\n                Text(\"Sensitivity X / Y\", fontSize = 13.sp, fontWeight = FontWeight.SemiBold, color = Color(0xFFE8EAF6))\n                Spacer(Modifier.height(12.dp))\n                SliderRow(\"X (horizontal)\", \"%.2f\".format(sensiX), accent, muted) {\n                    sensiX = it * 2.99f + 0.01f\n                }\n                SliderRow(\"Y (vertical)\", \"%.2f\".format(sensiY), accent, muted) {\n                    sensiY = it * 2.99f + 0.01f\n                }\n                SliderRow(\"Smooth / licin\", \"%.2f\".format(smooth), accent, muted) {\n                    smooth = it\n                }\n                SliderRow(\"Touch deadzone\", \"${deadzone}px\", accent, muted) {\n                    deadzone = (it * 20).toInt()\n                }\n                SliderRow(\"Pointer speed (\u22127\u2026+7)\", if (ptrSpeed >= 0) \"+$ptrSpeed\" else \"$ptrSpeed\", accent, muted) {\n                    ptrSpeed = (it * 14 - 7).toInt()\n                }\n                Spacer(Modifier.height(4.dp))\n                Button(\n                    onClick = {\n                        scope.launch {\n                            sensi.apply(SensitivityManager.Profile(sensiX, sensiY, smooth, deadzone, ptrSpeed))\n                        }\n                    },\n                    modifier = Modifier.fillMaxWidth(),\n                    colors   = ButtonDefaults.buttonColors(containerColor = Color(0xFF00E5A0), contentColor = Color(0xFF080810))\n                ) { Text(\"Apply via Shizuku\", fontWeight = FontWeight.Bold) }\n            }\n        }\n\n        item {\n            NexCard(card) {\n                Text(\"Smart DPI\", fontSize = 13.sp, fontWeight = FontWeight.SemiBold, color = Color(0xFFE8EAF6))\n                Spacer(Modifier.height(10.dp))\n                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n                    SmartDPI.PRESETS.take(4).forEach { preset ->\n                        Surface(\n                            modifier = Modifier.weight(1f).clickable { dpiValue = preset },\n                            shape    = RoundedCornerShape(8.dp),\n                            color    = if (dpiValue == preset) Color(0x2200E5A0) else Color(0x1AFFFFFF),\n                            border   = if (dpiValue == preset) ButtonDefaults.outlinedButtonBorder else null\n                        ) {\n                            Column(Modifier.padding(vertical = 8.dp), horizontalAlignment = Alignment.CenterHorizontally) {\n                                Text(\"$preset\", fontSize = 16.sp, fontWeight = FontWeight.Bold, color = if (dpiValue==preset) accent else Color(0xFFE8EAF6))\n                                Text(\"DPI\", fontSize = 10.sp, color = Color(0xFF6B7290))\n                            }\n                        }\n                    }\n                }\n                Spacer(Modifier.height(10.dp))\n                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {\n                    Text(\"wm density $dpiValue\", fontSize = 11.sp, color = Color(0xFF6B7290), fontFamily = FontFamily.Monospace)\n                    Text(\"native: ${smartDpi.nativeDpi()}dpi\", fontSize = 11.sp, color = Color(0xFF6B7290))\n                }\n                Spacer(Modifier.height(8.dp))\n                Button(\n                    onClick = { scope.launch { smartDpi.apply(dpiValue) } },\n                    modifier = Modifier.fillMaxWidth(),\n                    colors   = ButtonDefaults.buttonColors(containerColor = Color(0xFF00E5A0), contentColor = Color(0xFF080810))\n                ) { Text(\"Apply DPI\", fontWeight = FontWeight.Bold) }\n            }\n        }\n    }\n}\n\n@Composable\nfun SliderRow(label: String, value: String, accent: Color, muted: Color, onChange: (Float) -> Unit) {\n    var v by remember { mutableFloatStateOf(0.5f) }\n    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {\n        Text(label, fontSize = 12.sp, color = muted)\n        Text(value, fontSize = 12.sp, fontWeight = FontWeight.SemiBold, color = Color(0xFFE8EAF6))\n    }\n    Slider(value = v, onValueChange = { v = it; onChange(it) }, colors = SliderDefaults.colors(thumbColor = accent, activeTrackColor = accent))\n    Spacer(Modifier.height(4.dp))\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Games tab (static preview \u2014 wired to GameDetectorService in production)\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n@Composable\nfun GamesTab(accent: Color, muted: Color, card: Color) {\n    val games = listOf(\n        Triple(\"Mobile Legends\",  \"com.mobile.legends\",                   true),\n        Triple(\"Free Fire\",       \"com.dts.freefireth\",                   false),\n        Triple(\"PUBG Mobile\",     \"com.tencent.ig\",                        false),\n        Triple(\"COD Mobile\",      \"com.activision.callofduty.shooter\",     false),\n    )\n    LazyColumn(Modifier.fillMaxSize().padding(horizontal = 16.dp), contentPadding = PaddingValues(vertical = 12.dp)) {\n        item { NexCard(card) {\n            games.forEach { (label, pkg, live) ->\n                Row(Modifier.fillMaxWidth().padding(vertical = 8.dp), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {\n                    Column {\n                        Text(label, fontSize = 13.sp, fontWeight = FontWeight.SemiBold, color = Color(0xFFE8EAF6))\n                        Text(pkg, fontSize = 10.sp, color = muted, fontFamily = FontFamily.Monospace)\n                    }\n                    Surface(shape = RoundedCornerShape(10.dp), color = if (live) Color(0x2200E5A0) else Color(0x1AFFFFFF)) {\n                        Text(if (live) \"\u25cf Live\" else \"Standby\", Modifier.padding(horizontal = 10.dp, vertical = 4.dp), fontSize = 11.sp, color = if (live) accent else muted)\n                    }\n                }\n                if (label != games.last().first) HorizontalDivider(color = Color(0x1AFFFFFF), thickness = 0.5.dp)\n            }\n        }}\n    }\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Aftermatch\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n@Composable\nfun AftermatchTab(sessions: List<com.nexcore.optimizer.core.Aftermatch.Session>, accent: Color, warn: Color, danger: Color, muted: Color, card: Color) {\n    if (sessions.isEmpty()) {\n        Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {\n            Text(\"No sessions yet \u2014 start a game to record stats\", fontSize = 13.sp, color = muted)\n        }\n        return\n    }\n    LazyColumn(Modifier.fillMaxSize().padding(horizontal = 16.dp), verticalArrangement = Arrangement.spacedBy(8.dp), contentPadding = PaddingValues(vertical = 12.dp)) {\n        items(sessions) { s ->\n            NexCard(card) {\n                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {\n                    Column {\n                        Text(s.gameLabel, fontSize = 13.sp, fontWeight = FontWeight.SemiBold, color = Color(0xFFE8EAF6))\n                        Text(\"${s.startTime} \u00b7 ${s.durationMs/60000}m${(s.durationMs/1000)%60}s\", fontSize = 11.sp, color = muted)\n                    }\n                }\n                Spacer(Modifier.height(8.dp))\n                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceEvenly) {\n                    StatChip(\"${s.avgFps.toInt()} FPS\", \"avg\", accent)\n                    StatChip(\"%.0f\u00b0C\".format(s.peakTempC), \"peak temp\", warn)\n                    StatChip(\"${s.avgPingMs}ms\", \"avg ping\", accent)\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun StatChip(value: String, label: String, color: Color) {\n    Column(horizontalAlignment = Alignment.CenterHorizontally) {\n        Text(value, fontSize = 17.sp, fontWeight = FontWeight.Bold, color = color)\n        Text(label, fontSize = 10.sp, color = Color(0xFF6B7290))\n    }\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Blackbox\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n@Composable\nfun BlackboxTab(entries: List<Blackbox.Entry>, accent: Color, warn: Color, danger: Color, muted: Color) {\n    Column(Modifier.fillMaxSize().padding(horizontal = 16.dp, vertical = 12.dp)) {\n        LazyColumn(Modifier.weight(1f)) {\n            items(entries.reversed()) { e ->\n                Row(Modifier.padding(vertical = 1.dp)) {\n                    Text(\"[${e.ts}]\", fontSize = 10.sp, color = accent, fontFamily = FontFamily.Monospace)\n                    Text(\" [${e.tag}] \", fontSize = 10.sp, color = when (e.level) {\n                        Blackbox.Level.OK   -> Color(0xFF00E5A0)\n                        Blackbox.Level.WARN -> warn\n                        Blackbox.Level.ERR  -> danger\n                    }, fontFamily = FontFamily.Monospace)\n                    Text(e.msg, fontSize = 10.sp, color = Color(0xFF8899BB), fontFamily = FontFamily.Monospace)\n                }\n            }\n        }\n        Spacer(Modifier.height(8.dp))\n        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n            OutlinedButton(onClick = { Blackbox.clear() }, modifier = Modifier.weight(1f), colors = ButtonDefaults.outlinedButtonColors(contentColor = danger)) {\n                Text(\"Clear\", fontSize = 13.sp)\n            }\n        }\n    }\n}\n\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Shared component\n// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n@Composable\nfun NexCard(bg: Color, content: @Composable ColumnScope.() -> Unit) {\n    Surface(shape = RoundedCornerShape(14.dp), color = bg, modifier = Modifier.fillMaxWidth()) {\n        Column(Modifier.padding(14.dp), content = content)\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/AdaptivePerformance.kt", "content": "package com.nexcore.optimizer.core\n\n/**\n * Adaptive Performance \u2014 CPU governor and GPU frequency management via Shizuku shell.\n *\n * Supported governors on most SoCs:\n *   performance  \u2192 all cores at max freq (best FPS, highest heat)\n *   schedutil    \u2192 kernel-managed, good balance for LTPO displays\n *   powersave    \u2192 minimum freq (cool-down mode)\n *\n * GPU devfreq governors (Adreno/Mali):\n *   performance  \u2192 GPU at peak clock\n *   msm-adreno-tz \u2192 Qualcomm's thermal-aware default\n *   simple_ondemand \u2192 generic on-demand\n */\nclass AdaptivePerformance(private val shizuku: ShizukuManager) {\n\n    enum class Profile {\n        PERFORMANCE,   // all cores locked to max, GPU at peak\n        BALANCED,      // schedutil + msm-adreno-tz\n        POWERSAVE      // cool-down \u2014 trim freqs for thermal recovery\n    }\n\n    private val cpuGovPath = \"/sys/devices/system/cpu/cpu%d/cpufreq/scaling_governor\"\n    private val gpuGovPath = \"/sys/class/devfreq/kgsl-3d0/governor\"       // Adreno\n    private val gpuGovPathMali = \"/sys/class/devfreq/13000000.mali/governor\"\n\n    fun apply(profile: Profile): Boolean {\n        val (cpuGov, gpuGov) = when (profile) {\n            Profile.PERFORMANCE -> \"performance\" to \"performance\"\n            Profile.BALANCED    -> \"schedutil\"   to \"msm-adreno-tz\"\n            Profile.POWERSAVE   -> \"powersave\"   to \"simple_ondemand\"\n        }\n        var ok = setCpuGovernor(cpuGov)\n        ok = setGpuGovernor(gpuGov) && ok\n        Blackbox.log(\"PERF\", \"Profile ${profile.name} \u2192 cpu=$cpuGov gpu=$gpuGov (ok=$ok)\")\n        return ok\n    }\n\n    private fun setCpuGovernor(gov: String): Boolean {\n        val cores = Runtime.getRuntime().availableProcessors()\n        var allOk = true\n        for (i in 0 until cores) {\n            val path = cpuGovPath.format(i)\n            val out = shizuku.shell(\"echo $gov > $path 2>&1\")\n            if (out.contains(\"Permission denied\") || out.contains(\"No such file\")) {\n                Blackbox.warn(\"PERF\", \"cpu$i governor write failed\")\n                allOk = false\n            }\n        }\n        return allOk\n    }\n\n    private fun setGpuGovernor(gov: String): Boolean {\n        // Try Adreno path first, then Mali\n        for (path in listOf(gpuGovPath, gpuGovPathMali)) {\n            val test = shizuku.shell(\"test -f $path && echo 1\").trim()\n            if (test == \"1\") {\n                val out = shizuku.shell(\"echo $gov > $path 2>&1\")\n                return !out.contains(\"error\", ignoreCase = true)\n            }\n        }\n        Blackbox.warn(\"PERF\", \"No known GPU devfreq governor path found\")\n        return false\n    }\n\n    /** Lock CPU max frequency per cluster (prime/big/little) for a game profile. */\n    fun lockCluster(cluster: Cluster, freqKhz: Int) {\n        val cores = cluster.coreIndices\n        for (i in cores) {\n            shizuku.shell(\n                \"echo $freqKhz > /sys/devices/system/cpu/cpu$i/cpufreq/scaling_max_freq\"\n            )\n        }\n        Blackbox.log(\"PERF\", \"Cluster ${cluster.name} locked @ ${freqKhz/1000} MHz (cores=$cores)\")\n    }\n\n    enum class Cluster(val coreIndices: List<Int>) {\n        PRIME(listOf(7)),\n        BIG(listOf(4, 5, 6)),\n        LITTLE(listOf(0, 1, 2, 3))\n    }\n\n    fun getCurrentGovernors(): Map<String, String> {\n        val cores = Runtime.getRuntime().availableProcessors()\n        return (0 until cores).associate { i ->\n            val gov = try {\n                shizuku.shell(\"cat ${cpuGovPath.format(i)}\").trim()\n            } catch (_: Exception) { \"unknown\" }\n            \"cpu$i\" to gov\n        }\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/Aftermatch.kt", "content": "package com.nexcore.optimizer.core\n\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport java.text.SimpleDateFormat\nimport java.util.Date\nimport java.util.Locale\n\n/**\n * Aftermatch \u2014 records per-game session telemetry and exposes it as StateFlow.\n *\n * A session begins when [startSession] is called (triggered by GameDetectorService\n * when a monitored game reaches the foreground) and ends when [endSession] is\n * called (game goes to background or is closed).\n *\n * During the session, [sample] is called periodically (every 500ms by the service)\n * to collect FPS, temperature, and ping. At session end these are averaged and\n * the [Session] is emitted to [history].\n */\nclass Aftermatch {\n\n    data class Session(\n        val id         : String,\n        val gamePkg    : String,\n        val gameLabel  : String,\n        val startTime  : String,\n        val durationMs : Long,\n        val avgFps     : Float,\n        val peakTempC  : Float,\n        val avgPingMs  : Long,\n        val minPingMs  : Long,\n        val maxPingMs  : Long,\n        val perfProfile: String,\n        val dpi        : Int\n    )\n\n    private data class Live(\n        val pkg      : String,\n        val label    : String,\n        val startMs  : Long,\n        val perfProf : String,\n        val dpi      : Int\n    )\n\n    private val sdf = SimpleDateFormat(\"HH:mm\", Locale.US)\n\n    private var live     : Live? = null\n    private val fpsSamples   = mutableListOf<Float>()\n    private val tempSamples  = mutableListOf<Float>()\n    private val pingSamples  = mutableListOf<Long>()\n\n    private val _history  = MutableStateFlow<List<Session>>(emptyList())\n    val history: StateFlow<List<Session>> = _history.asStateFlow()\n\n    private val _active = MutableStateFlow(false)\n    val active: StateFlow<Boolean> = _active.asStateFlow()\n\n    fun startSession(pkg: String, label: String, perfProfile: String, dpi: Int) {\n        if (live != null) endSession()\n        live = Live(pkg, label, System.currentTimeMillis(), perfProfile, dpi)\n        fpsSamples.clear(); tempSamples.clear(); pingSamples.clear()\n        _active.value = true\n        Blackbox.log(\"AFTER\", \"Session started: $label ($pkg)\")\n    }\n\n    /** Call every ~500ms from GameDetectorService. All values are current readings. */\n    fun sample(fps: Float, tempC: Float, pingMs: Long) {\n        if (live == null) return\n        if (fps   > 0f ) fpsSamples  += fps\n        if (tempC > 0f ) tempSamples += tempC\n        if (pingMs > 0L) pingSamples += pingMs\n    }\n\n    fun endSession(): Session? {\n        val l = live ?: return null\n        val dur = System.currentTimeMillis() - l.startMs\n        val session = Session(\n            id          = \"${l.pkg}:${l.startMs}\",\n            gamePkg     = l.pkg,\n            gameLabel   = l.label,\n            startTime   = sdf.format(Date(l.startMs)),\n            durationMs  = dur,\n            avgFps      = fpsSamples.average().toFloat().takeIf { !it.isNaN() } ?: 0f,\n            peakTempC   = tempSamples.maxOrNull() ?: 0f,\n            avgPingMs   = pingSamples.average().toLong().takeIf { !it.isNaN() } ?: 0L,\n            minPingMs   = pingSamples.minOrNull() ?: 0L,\n            maxPingMs   = pingSamples.maxOrNull() ?: 0L,\n            perfProfile = l.perfProf,\n            dpi         = l.dpi\n        )\n        _history.value = listOf(session) + _history.value.take(49)  // keep last 50\n        _active.value  = false\n        live           = null\n        Blackbox.log(\n            \"AFTER\",\n            \"Session saved: ${session.gameLabel} ${dur/60000}m${(dur/1000)%60}s \" +\n            \"avg${session.avgFps.toInt()}fps ${session.peakTempC.toInt()}\u00b0C ${session.avgPingMs}ms\"\n        )\n        return session\n    }\n\n    fun currentDuration(): Long = live?.let { System.currentTimeMillis() - it.startMs } ?: 0L\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/Blackbox.kt", "content": "package com.nexcore.optimizer.core\n\nimport android.util.Log\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport java.io.File\nimport java.text.SimpleDateFormat\nimport java.util.Date\nimport java.util.Locale\nimport java.util.concurrent.LinkedBlockingDeque\n\n/** Thread-safe singleton logger. All modules write here; UI observes [flow]. */\nobject Blackbox {\n\n    private const val TAG     = \"NexCore\"\n    private const val MAX     = 500\n    private val sdf            = SimpleDateFormat(\"HH:mm:ss\", Locale.US)\n\n    enum class Level { OK, WARN, ERR }\n\n    data class Entry(\n        val ts   : String,\n        val tag  : String,\n        val msg  : String,\n        val level: Level\n    )\n\n    private val buf   = LinkedBlockingDeque<Entry>(MAX)\n    private val _flow = MutableStateFlow<List<Entry>>(emptyList())\n    val flow: StateFlow<List<Entry>> = _flow.asStateFlow()\n\n    fun log(tag: String, msg: String, level: Level = Level.OK) {\n        val e = Entry(sdf.format(Date()), tag, msg, level)\n        if (buf.size >= MAX) buf.pollFirst()\n        buf.addLast(e)\n        _flow.value = buf.toList()\n        when (level) {\n            Level.OK   -> Log.d(TAG, \"[$tag] $msg\")\n            Level.WARN -> Log.w(TAG, \"[$tag] $msg\")\n            Level.ERR  -> Log.e(TAG, \"[$tag] $msg\")\n        }\n    }\n\n    fun warn(tag: String, msg: String) = log(tag, msg, Level.WARN)\n    fun err(tag: String, msg: String)  = log(tag, msg, Level.ERR)\n\n    fun exportTo(file: File) {\n        file.bufferedWriter().use { w ->\n            buf.forEach { w.write(\"[${it.ts}] [${it.tag}] ${it.msg}\\n\") }\n        }\n        log(\"BLACKBOX\", \"Exported ${buf.size} entries \u2192 ${file.name}\")\n    }\n\n    fun clear() {\n        buf.clear()\n        _flow.value = emptyList()\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/DeviceDNA.kt", "content": "package com.nexcore.optimizer.core\n\nimport android.os.Build\n\n/**\n * Device DNA \u2014 a stable fingerprint string derived from hardware constants.\n * Used to cache per-device optimization profiles and restore them across boots.\n *\n * Format: <SoC>-<RAM_GB>G-<DisplayHz>H\n * Example: SD8G2-12G-144H\n */\nclass DeviceDNA(private val scan: SmartScan) {\n\n    data class Profile(\n        val fingerprint : String,\n        val socLabel    : String,\n        val ramGb       : Int,\n        val displayHz   : Int,\n        val touchHz     : Int,\n        val cpuMaxMhz   : Int,\n        val gpuRenderer : String,\n        val optScore    : Int       // 0\u2013100, used by NeuralEngine as baseline\n    )\n\n    fun build(): Profile {\n        val r = scan.scan()\n        val fp = buildFingerprint(r)\n        val score = scoreDevice(r)\n        val p = Profile(\n            fingerprint  = fp,\n            socLabel     = r.soC,\n            ramGb        = (r.ramTotalMb / 1024).toInt(),\n            displayHz    = r.displayHz,\n            touchHz      = r.touchHzEst,\n            cpuMaxMhz    = r.cpuMaxFreqMhz,\n            gpuRenderer  = r.gpuRenderer,\n            optScore     = score\n        )\n        Blackbox.log(\"DNA\", \"Fingerprint: ${p.fingerprint} \u00b7 score=${p.optScore}\")\n        return p\n    }\n\n    private fun buildFingerprint(r: SmartScan.Result): String {\n        val soc = when {\n            \"8 Gen 3\" in r.soC -> \"SD8G3\"\n            \"8 Gen 2\" in r.soC -> \"SD8G2\"\n            \"8 Gen 1\" in r.soC -> \"SD8G1\"\n            \"Tensor\"  in r.soC -> \"TENSOR\"\n            \"Dimensity\" in r.soC -> \"DIM\"\n            else -> Build.BOARD.take(6).uppercase()\n        }\n        val ram = \"${(r.ramTotalMb / 1024).toInt()}G\"\n        val hz  = \"${r.displayHz}H\"\n        return \"$soc-$ram-$hz\"\n    }\n\n    /**\n     * Device capability score (0\u2013100):\n     * 40 pts CPU max freq, 20 pts RAM, 20 pts display Hz, 20 pts touch Hz.\n     */\n    private fun scoreDevice(r: SmartScan.Result): Int {\n        val cpu   = (r.cpuMaxFreqMhz.toFloat() / 3200f * 40).toInt().coerceIn(0, 40)\n        val ram   = ((r.ramTotalMb  / 1024f) / 16f * 20).toInt().coerceIn(0, 20)\n        val disp  = (r.displayHz.toFloat() / 165f * 20).toInt().coerceIn(0, 20)\n        val touch = (r.touchHzEst.toFloat() / 300f * 20).toInt().coerceIn(0, 20)\n        return cpu + ram + disp + touch\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/NetworkIntelligence.kt", "content": "package com.nexcore.optimizer.core\n\nimport android.content.Context\nimport android.net.ConnectivityManager\nimport android.net.NetworkCapabilities\nimport android.net.wifi.WifiManager\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.withContext\nimport java.net.InetAddress\n\n/**\n * Network Intelligence \u2014 measures latency, sets WiFi lock, and optimizes DNS.\n *\n * DNS servers used in-game: 8.8.8.8 (Google) and 1.1.1.1 (Cloudflare).\n * WiFi lock prevents the radio from dropping to 20 MHz bandwidth while gaming.\n */\nclass NetworkIntelligence(\n    private val context: Context,\n    private val shizuku: ShizukuManager\n) {\n    data class Stats(\n        val pingMs      : Long,\n        val jitterMs    : Float,\n        val packetLoss  : Float,   // 0.0\u20131.0\n        val wifiRssi    : Int,     // dBm\n        val wifiChannel : Int\n    )\n\n    private var wifiLock: WifiManager.WifiLock? = null\n\n    /** Ping [host] [count] times; returns median RTT in ms. */\n    suspend fun ping(host: String = \"8.8.8.8\", count: Int = 5): Long =\n        withContext(Dispatchers.IO) {\n            val results = mutableListOf<Long>()\n            repeat(count) {\n                val start = System.currentTimeMillis()\n                try {\n                    InetAddress.getByName(host).isReachable(1000)\n                    results += System.currentTimeMillis() - start\n                } catch (_: Exception) { }\n            }\n            results.sorted().getOrElse(results.size / 2) { 999L }\n        }\n\n    suspend fun measure(): Stats = withContext(Dispatchers.IO) {\n        val samples = (1..5).map { i ->\n            val t = System.currentTimeMillis()\n            try { InetAddress.getByName(\"8.8.8.8\").isReachable(800) } catch (_: Exception) { }\n            System.currentTimeMillis() - t\n        }\n        val median  = samples.sorted()[2].toLong()\n        val jitter  = samples.map { (it - median).toFloat() }.map { kotlin.math.abs(it) }.average().toFloat()\n        val loss    = samples.count { it >= 800 }.toFloat() / samples.size\n\n        val wm      = context.getSystemService(Context.WIFI_SERVICE) as WifiManager\n        val wifiInfo = wm.connectionInfo\n        Stats(\n            pingMs     = median,\n            jitterMs   = jitter,\n            packetLoss = loss,\n            wifiRssi   = wifiInfo?.rssi ?: -99,\n            wifiChannel = wifiInfo?.frequency?.let { freqToChannel(it) } ?: 0\n        ).also { Blackbox.log(\"NET\", \"ping=${it.pingMs}ms jitter=${String.format(\"%.1f\",it.jitterMs)}ms loss=${(it.packetLoss*100).toInt()}%\") }\n    }\n\n    /** Acquire high-performance WiFi lock \u2014 prevents radio from downclocking during game. */\n    fun acquireWifiLock(tag: String = \"NexCore:gaming\") {\n        val wm = context.applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager\n        wifiLock?.release()\n        wifiLock = wm.createWifiLock(WifiManager.WIFI_MODE_FULL_HIGH_PERF, tag).also {\n            it.setReferenceCounted(false)\n            it.acquire()\n            Blackbox.log(\"NET\", \"WiFi lock acquired ($tag)\")\n        }\n    }\n\n    fun releaseWifiLock() {\n        wifiLock?.takeIf { it.isHeld }?.release()\n        wifiLock = null\n        Blackbox.log(\"NET\", \"WiFi lock released\")\n    }\n\n    /** Override DNS to 8.8.8.8 on the active network via ndc (needs shell uid). */\n    fun setGameDns() {\n        shizuku.shell(\"ndc resolver setnetdns \\$(dumpsys connectivity | grep 'default network' | grep -oP '\\\\d+' | head -1) '' 8.8.8.8 1.1.1.1\")\n        Blackbox.log(\"NET\", \"DNS set to 8.8.8.8 / 1.1.1.1\")\n    }\n\n    fun isWifiConnected(): Boolean {\n        val cm = context.getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager\n        val nc = cm.getNetworkCapabilities(cm.activeNetwork) ?: return false\n        return nc.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)\n    }\n\n    private fun freqToChannel(freq: Int): Int = when {\n        freq in 2412..2484 -> (freq - 2412) / 5 + 1\n        freq in 5170..5825 -> (freq - 5170) / 5 + 34\n        freq in 5945..7125 -> (freq - 5945) / 5 + 1   // 6 GHz (WiFi 6E)\n        else -> 0\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/NeuralEngine.kt", "content": "package com.nexcore.optimizer.core\n\nimport kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.SupervisorJob\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport kotlinx.coroutines.launch\n\n/**\n * Neural Engine \u2014 heuristic optimization engine.\n *\n * Scores the current device + session context (0\u2013100) and derives the best\n * performance profile + sensitivity preset for the active game.\n *\n * \"Neural\" here refers to a weighted scoring model \u2014 not a TFLite model \u2014\n * which is intentional: a lightweight rule-based engine has zero cold-start\n * latency and no APK size cost, while covering the same decision space for\n * the target use case (mobile gaming optimization).\n *\n * To extend to a real on-device model: drop a .tflite file in assets/ and\n * replace [computeScore] with a TensorFlow Lite Interpreter call.\n */\nclass NeuralEngine(\n    private val perf    : AdaptivePerformance,\n    private val thermal : ThermalGuardian,\n    private val net     : NetworkIntelligence,\n    private val dna     : DeviceDNA\n) {\n    private val scope    = CoroutineScope(SupervisorJob() + Dispatchers.Default)\n    private val _score   = MutableStateFlow(0)\n    val score: StateFlow<Int> = _score.asStateFlow()\n\n    private var profile: DeviceDNA.Profile? = null\n\n    fun init(deviceProfile: DeviceDNA.Profile) {\n        profile = deviceProfile\n        recompute()\n        Blackbox.log(\"NEURAL\", \"Engine initialized \u00b7 baseline score=${deviceProfile.optScore}\")\n    }\n\n    /**\n     * Recompute optimization score from current thermal + network state.\n     * Score components:\n     *   40 pts \u2014 device baseline (from DeviceDNA)\n     *   20 pts \u2014 thermal headroom (100% = no throttle, 0% = critical)\n     *   20 pts \u2014 network quality (ping < 30ms = full, >100ms = 0)\n     *   20 pts \u2014 active module bonus (each active module = +4 pts, max 5)\n     */\n    fun recompute(activeModules: Int = 5) {\n        scope.launch {\n            val base    = profile?.optScore ?: 50\n            val thState = thermal.state.value\n            val thPts   = when (thState) {\n                ThermalGuardian.State.NORMAL   -> 20\n                ThermalGuardian.State.WARM     -> 15\n                ThermalGuardian.State.HOT      -> 8\n                ThermalGuardian.State.CRITICAL -> 0\n            }\n            val ping    = net.ping()\n            val netPts  = when {\n                ping < 15  -> 20\n                ping < 30  -> 16\n                ping < 60  -> 10\n                ping < 100 -> 5\n                else       -> 0\n            }.toInt()\n            val modPts  = (activeModules.coerceIn(0, 5) * 4)\n\n            val raw   = base + thPts + netPts + modPts\n            val final = raw.coerceIn(0, 100)\n            _score.value = final\n            Blackbox.log(\"NEURAL\", \"Score=$final (base=$base th=$thPts net=$netPts mod=$modPts)\")\n        }\n    }\n\n    /**\n     * Recommend the best [AdaptivePerformance.Profile] for current conditions.\n     * Also returns recommended DPI based on device capability.\n     */\n    data class Recommendation(\n        val perfProfile : AdaptivePerformance.Profile,\n        val dpiTarget   : Int,\n        val reason      : String\n    )\n\n    fun recommend(gamePkg: String): Recommendation {\n        val s     = _score.value\n        val th    = thermal.state.value\n        val p     = profile\n\n        val recPerf = when {\n            th == ThermalGuardian.State.CRITICAL -> AdaptivePerformance.Profile.POWERSAVE\n            th == ThermalGuardian.State.HOT      -> AdaptivePerformance.Profile.BALANCED\n            s >= 70                               -> AdaptivePerformance.Profile.PERFORMANCE\n            s >= 40                               -> AdaptivePerformance.Profile.BALANCED\n            else                                  -> AdaptivePerformance.Profile.POWERSAVE\n        }\n\n        // Target 240 DPI on mid-range (score<60), 320 on high-end (score>=70), 360 on flagship\n        val recDpi = when {\n            (p?.optScore ?: 0) >= 85 -> 360\n            (p?.optScore ?: 0) >= 70 -> 320\n            else                     -> 240\n        }\n\n        val reason = \"score=$s thermal=${th.name} \u2192 ${recPerf.name} @ ${recDpi}DPI\"\n        Blackbox.log(\"NEURAL\", \"Recommend for $gamePkg: $reason\")\n        return Recommendation(recPerf, recDpi, reason)\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/SensitivityManager.kt", "content": "package com.nexcore.optimizer.core\n\nimport android.content.Context\nimport android.provider.Settings\n\n/**\n * Sensitivity Manager \u2014 per-axis sensitivity, smooth factor, and touch deadzone.\n *\n * Settings path: Settings.System.POINTER_SPEED \u2014 int \u22127 to +7.\n *   \u22127 = slowest (1/32\u00d7 multiplier internally)\n *   0  = neutral\n *   +7 = fastest (32\u00d7 multiplier)\n *\n * Smooth factor (licin): written to SoC-specific sysfs touch nodes when available:\n *   Snapdragon: /sys/devices/virtual/touchscreen/touchscreen/sensitivity\n *   OPPO/OnePlus: /proc/touchpanel/smooth_level\n *   Samsung Exynos: /sys/class/sec/tsp/cmd  (via \"set_grip_data\" or smooth cmd)\n *\n * X/Y are stored in-app as a game profile overlay; they feed into game-specific\n * ADB overlayConfigs where supported (some game engines read these at startup).\n */\nclass SensitivityManager(\n    private val context: Context,\n    private val shizuku: ShizukuManager\n) {\n    data class Profile(\n        val x           : Float = 1.6f,   // 0.01 \u2013 3.00 relative X scale\n        val y           : Float = 1.6f,   // 0.01 \u2013 3.00 relative Y scale\n        val smooth      : Float = 0.75f,  // 0.00 (raw) \u2013 1.00 (max smooth)\n        val deadzone    : Int   = 2,      // pixels 0\u201320\n        val pointerSpeed: Int   = 3       // Settings.System.POINTER_SPEED  \u22127\u2026+7\n    )\n\n    companion object {\n        /** Preset profiles keyed by package name. */\n        val GAME_PROFILES = mapOf(\n            \"com.mobile.legends\"                   to Profile(x=1.6f, y=1.6f, smooth=0.75f, deadzone=2, pointerSpeed=3),\n            \"com.dts.freefireth\"                   to Profile(x=2.0f, y=2.0f, smooth=0.50f, deadzone=1, pointerSpeed=4),\n            \"com.tencent.ig\"                       to Profile(x=1.4f, y=1.4f, smooth=0.80f, deadzone=3, pointerSpeed=2),\n            \"com.activision.callofduty.shooter\"    to Profile(x=1.8f, y=1.8f, smooth=0.60f, deadzone=2, pointerSpeed=3),\n            \"com.garena.game.codm\"                 to Profile(x=1.8f, y=1.8f, smooth=0.60f, deadzone=2, pointerSpeed=3),\n            \"com.pearlabyss.blackdesertm\"          to Profile(x=1.3f, y=1.3f, smooth=0.90f, deadzone=4, pointerSpeed=1),\n        )\n    }\n\n    private var active: Profile = Profile()\n\n    fun apply(profile: Profile): Boolean {\n        active = profile\n        val ptrOk  = applyPointerSpeed(profile.pointerSpeed)\n        val sysOk  = applyTouchSmooth(profile.smooth)\n        applyDeadzone(profile.deadzone)\n        Blackbox.log(\n            \"SENSI\",\n            \"x=${profile.x} y=${profile.y} smooth=${profile.smooth} dead=${profile.deadzone}px ptr=${profile.pointerSpeed} \u2192 ptrOk=$ptrOk sysOk=$sysOk\"\n        )\n        return ptrOk\n    }\n\n    fun applyForGame(pkg: String): Boolean {\n        val p = GAME_PROFILES[pkg] ?: active\n        return apply(p)\n    }\n\n    private fun applyPointerSpeed(speed: Int): Boolean {\n        require(speed in -7..7) { \"pointer_speed must be in \u22127..7, got $speed\" }\n        return shizuku.putSetting(\"system\", \"pointer_speed\", speed.toString())\n    }\n\n    private fun applyTouchSmooth(smooth: Float): Boolean {\n        val sysVal = (smooth * 255).toInt().coerceIn(0, 255)\n        val candidates = listOf(\n            \"/sys/devices/virtual/touchscreen/touchscreen/sensitivity\",\n            \"/proc/touchpanel/smooth_level\",\n            \"/sys/class/input/input1/sensitivity\",\n            \"/sys/class/sec/tsp/cmd\"              // Samsung \u2014 needs special format\n        )\n        for (path in candidates) {\n            val exists = shizuku.shell(\"test -e $path && echo 1\").trim()\n            if (exists == \"1\") {\n                shizuku.shell(\"echo $sysVal > $path\")\n                Blackbox.log(\"SENSI\", \"smooth=$sysVal \u2192 $path\")\n                return true\n            }\n        }\n        Blackbox.warn(\"SENSI\", \"No touch smooth sysfs path found on this device\")\n        return false\n    }\n\n    private fun applyDeadzone(px: Int) {\n        // Some kernels expose deadzone via /proc; otherwise stored in app only\n        val path = \"/proc/touchpanel/dead_zone\"\n        val exists = shizuku.shell(\"test -e $path && echo 1\").trim()\n        if (exists == \"1\") {\n            shizuku.shell(\"echo $px > $path\")\n            Blackbox.log(\"SENSI\", \"deadzone=${px}px \u2192 $path\")\n        }\n    }\n\n    fun getCurrentPointerSpeed(): Int = try {\n        Settings.System.getInt(context.contentResolver, Settings.System.POINTER_SPEED, 0)\n    } catch (_: Exception) { 0 }\n\n    fun getActive(): Profile = active\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/ShizukuManager.kt", "content": "package com.nexcore.optimizer.core\n\nimport android.content.ComponentName\nimport android.content.Context\nimport android.content.ServiceConnection\nimport android.os.IBinder\nimport android.os.RemoteException\nimport com.nexcore.optimizer.service.IUserService\nimport com.nexcore.optimizer.service.NexCoreUserService\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport rikka.shizuku.Shizuku\n\n/**\n * Manages Shizuku binder lifecycle, permission, and UserService binding.\n *\n * Usage:\n *   val shizuku = ShizukuManager(context)\n *   shizuku.init()                       // call from Application.onCreate\n *   shizuku.shell(\"wm density 360\")      // run as shell uid=2000\n *   shizuku.putSetting(\"system\",\"pointer_speed\",\"3\")\n */\nclass ShizukuManager(private val context: Context) {\n\n    companion object { const val REQ_PERM = 1001 }\n\n    private var svc: IUserService? = null\n    private val _ok = MutableStateFlow(false)\n    val connected: StateFlow<Boolean> = _ok.asStateFlow()\n\n    private val onBound = Shizuku.OnBinderReceivedListener {\n        Blackbox.log(\"SHIZUKU\", \"Binder received \u00b7 uid=${Shizuku.getUid()}\")\n        handleBinder()\n    }\n    private val onDead = Shizuku.OnBinderDeadListener {\n        _ok.value = false; svc = null\n        Blackbox.warn(\"SHIZUKU\", \"Binder dead \u2014 waiting for restart\")\n    }\n    private val onPerm = Shizuku.OnRequestPermissionResultListener { _, r ->\n        if (r == android.content.pm.PackageManager.PERMISSION_GRANTED) bindUserService()\n        else Blackbox.warn(\"SHIZUKU\", \"Permission denied by user\")\n    }\n\n    fun init() {\n        Shizuku.addBinderReceivedListener(onBound)\n        Shizuku.addBinderDeadListener(onDead)\n        Shizuku.addRequestPermissionResultListener(onPerm)\n        if (Shizuku.pingBinder()) handleBinder()\n    }\n\n    private fun handleBinder() {\n        if (Shizuku.checkSelfPermission() == android.content.pm.PackageManager.PERMISSION_GRANTED)\n            bindUserService()\n        else\n            Shizuku.requestPermission(REQ_PERM)\n    }\n\n    private val args = Shizuku.UserServiceArgs(\n        ComponentName(context.packageName, NexCoreUserService::class.java.name)\n    ).daemon(false).processNameSuffix(\"service\").debuggable(false).version(1)\n\n    private val conn = object : ServiceConnection {\n        override fun onServiceConnected(n: ComponentName?, b: IBinder?) {\n            svc = IUserService.Stub.asInterface(b)\n            _ok.value = true\n            Blackbox.log(\"SHIZUKU\", \"UserService connected\")\n        }\n        override fun onServiceDisconnected(n: ComponentName?) {\n            svc = null; _ok.value = false\n            Blackbox.warn(\"SHIZUKU\", \"UserService disconnected\")\n        }\n    }\n\n    private fun bindUserService() = Shizuku.bindUserService(args, conn)\n\n    /**\n     * Run [cmd] as shell (uid=2000) via Shizuku UserService.\n     * Returns stdout; empty string on error.\n     */\n    fun shell(cmd: String): String = try {\n        svc?.executeCommand(cmd) ?: localShell(cmd)\n    } catch (e: RemoteException) {\n        Blackbox.err(\"SHIZUKU\", \"RemoteException: ${e.message}\")\n        \"\"\n    }\n\n    private fun localShell(cmd: String): String = try {\n        val p = Runtime.getRuntime().exec(arrayOf(\"sh\", \"-c\", cmd))\n        p.inputStream.bufferedReader().readText().trim()\n    } catch (_: Exception) { \"\" }\n\n    /** `settings put <namespace> <key> <value>` */\n    fun putSetting(ns: String, key: String, value: String): Boolean {\n        val out = shell(\"settings put $ns $key $value\")\n        Blackbox.log(\"SETTINGS\", \"$ns/$key=$value\")\n        return out.isBlank() || !out.contains(\"Error\", ignoreCase = true)\n    }\n\n    fun isAvailable() = _ok.value && try { Shizuku.pingBinder() } catch (_: Exception) { false }\n\n    fun destroy() {\n        Shizuku.removeBinderReceivedListener(onBound)\n        Shizuku.removeBinderDeadListener(onDead)\n        Shizuku.removeRequestPermissionResultListener(onPerm)\n        if (_ok.value) Shizuku.unbindUserService(args, conn, true)\n        _ok.value = false\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/SmartDPI.kt", "content": "package com.nexcore.optimizer.core\n\nimport android.content.Context\nimport android.util.DisplayMetrics\n\n/**\n * Smart DPI \u2014 applies display density via `wm density <dpi>` through Shizuku.\n *\n * Lower DPI = more screen space per logical pixel = less GPU work per frame.\n * Useful for older/mid-range devices to gain FPS headroom in games that\n * render at display density.\n *\n * Safe range: 160\u2013640 dp. Below 160 the launcher becomes unusable.\n * Above the native DPI there is no visual benefit and wastes GPU bandwidth.\n *\n * Example:\n *   smartDPI.apply(240)       // wm density 240\n *   smartDPI.reset()          // wm density reset  (back to native)\n *   smartDPI.optimalFor(1.0f) // compute best DPI for a 1\u00d7 sensitivity factor\n */\nclass SmartDPI(\n    private val context: Context,\n    private val shizuku: ShizukuManager\n) {\n    companion object {\n        /** Common DPI presets used in gaming optimizer tools. */\n        val PRESETS = listOf(240, 300, 360, 400, 480, 540, 560, 640)\n\n        const val MIN_DPI = 160\n        const val MAX_DPI = 640\n    }\n\n    /** Physical (native) display DPI from DisplayMetrics. */\n    fun nativeDpi(): Int = context.resources.displayMetrics.densityDpi\n\n    /**\n     * Compute the optimal preset for a desired sensitivity scaling factor.\n     * Base is 320 dp; factor 1.0 \u2192 320, factor 0.75 \u2192 240, factor 1.25 \u2192 400.\n     * Result snapped to nearest value in [PRESETS].\n     */\n    fun optimalFor(sensitivityFactor: Float = 1.0f): Int {\n        val target = (320 * sensitivityFactor).toInt().coerceIn(MIN_DPI, MAX_DPI)\n        return PRESETS.minByOrNull { kotlin.math.abs(it - target) } ?: 320\n    }\n\n    /**\n     * Apply [dpi] via `wm density <dpi>`.\n     * Requires shell UID (Shizuku) \u2014 WRITE_SECURE_SETTINGS is insufficient for wm.\n     * Returns true when stdout is empty (success) or false on error.\n     */\n    fun apply(dpi: Int): Boolean {\n        require(dpi in MIN_DPI..MAX_DPI) { \"DPI $dpi out of safe range $MIN_DPI\u2013$MAX_DPI\" }\n        val out = shizuku.shell(\"wm density $dpi\")\n        val ok  = out.isBlank() || !out.contains(\"Error\", ignoreCase = true)\n        Blackbox.log(\"DPI\", \"wm density $dpi \u2192 ${if (ok) \"applied\" else \"failed: $out\"}\")\n        return ok\n    }\n\n    /**\n     * Reset to native DPI.\n     * Equivalent to: adb shell wm density reset\n     */\n    fun reset(): Boolean {\n        val out = shizuku.shell(\"wm density reset\")\n        val ok  = out.isBlank()\n        Blackbox.log(\"DPI\", \"wm density reset \u2192 ${if (ok) \"ok\" else \"failed: $out\"}\")\n        return ok\n    }\n\n    /**\n     * Read current override DPI from `wm density` output.\n     * Output format:\n     *   Physical density: 420\n     *   Override density: 240   \u2190 present only when overridden\n     * Returns override if set, else physical density.\n     */\n    fun current(): Int {\n        val out   = shizuku.shell(\"wm density\")\n        val ovrd  = Regex(\"Override density:\\s*(\\d+)\").find(out)?.groupValues?.get(1)?.toIntOrNull()\n        val phys  = Regex(\"Physical density:\\s*(\\d+)\").find(out)?.groupValues?.get(1)?.toIntOrNull()\n        return ovrd ?: phys ?: nativeDpi()\n    }\n\n    fun isOverridden(): Boolean {\n        val out = shizuku.shell(\"wm density\")\n        return out.contains(\"Override density\", ignoreCase = true)\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/SmartScan.kt", "content": "package com.nexcore.optimizer.core\n\nimport android.app.ActivityManager\nimport android.content.Context\nimport android.os.Build\nimport android.view.WindowManager\nimport java.io.File\n\n/** Reads hardware capabilities via /proc, /sys, ActivityManager, and WindowManager. */\nclass SmartScan(\n    private val context: Context,\n    private val shizuku: ShizukuManager\n) {\n    data class Result(\n        val cpuCores     : Int,\n        val cpuMaxFreqMhz: Int,            // big-core maximum frequency\n        val gpuRenderer  : String,\n        val ramTotalMb   : Long,\n        val ramFreeMb    : Long,\n        val displayHz    : Int,\n        val touchHzEst   : Int,            // best-guess touch sampling rate\n        val kernelVersion: String,\n        val soC          : String\n    )\n\n    fun scan(): Result {\n        val cpuInfo   = readCpuInfo()\n        val memInfo   = readMemInfo()\n        val displayHz = getDisplayHz()\n        val r = Result(\n            cpuCores      = Runtime.getRuntime().availableProcessors(),\n            cpuMaxFreqMhz = cpuMaxFreq() / 1000,\n            gpuRenderer   = gpuRenderer(),\n            ramTotalMb    = memInfo.first,\n            ramFreeMb     = memInfo.second,\n            displayHz     = displayHz,\n            touchHzEst    = estimateTouchHz(displayHz),\n            kernelVersion = System.getProperty(\"os.version\") ?: \"unknown\",\n            soC           = detectSoC(cpuInfo)\n        )\n        Blackbox.log(\"SCAN\", \"CPU: ${r.cpuCores} cores @ ${r.cpuMaxFreqMhz} MHz max\")\n        Blackbox.log(\"SCAN\", \"RAM: ${r.ramFreeMb} MB free / ${r.ramTotalMb} MB total\")\n        Blackbox.log(\"SCAN\", \"Display: ${r.displayHz} Hz \u00b7 Touch ~${r.touchHzEst} Hz\")\n        Blackbox.log(\"SCAN\", \"SoC: ${r.soC} \u00b7 GPU: ${r.gpuRenderer}\")\n        return r\n    }\n\n    private fun readCpuInfo(): String = try {\n        File(\"/proc/cpuinfo\").readText()\n    } catch (_: Exception) { \"\" }\n\n    private fun cpuMaxFreq(): Int {\n        // /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq \u2014 one line per core\n        val maxFreqs = (0..7).mapNotNull { i ->\n            try {\n                File(\"/sys/devices/system/cpu/cpu$i/cpufreq/cpuinfo_max_freq\")\n                    .readText().trim().toIntOrNull()\n            } catch (_: Exception) { null }\n        }\n        return maxFreqs.maxOrNull() ?: 0\n    }\n\n    private fun gpuRenderer(): String {\n        // /sys/class/kgsl/kgsl-3d0/gpu_model is available on Snapdragon\n        val kgsl = try { File(\"/sys/class/kgsl/kgsl-3d0/gpu_model\").readText().trim() } catch (_: Exception) { \"\" }\n        if (kgsl.isNotEmpty()) return kgsl\n        // Mali: /sys/class/misc/mali0/device/gpuinfo\n        val mali = try { File(\"/sys/class/misc/mali0/device/gpuinfo\").readText().trim() } catch (_: Exception) { \"\" }\n        return mali.ifEmpty { Build.HARDWARE }\n    }\n\n    private fun readMemInfo(): Pair<Long, Long> {\n        val am = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager\n        val info = ActivityManager.MemoryInfo()\n        am.getMemoryInfo(info)\n        return Pair(info.totalMem / 1024 / 1024, info.availMem / 1024 / 1024)\n    }\n\n    private fun getDisplayHz(): Int {\n        val wm = context.getSystemService(Context.WINDOW_SERVICE) as WindowManager\n        return if (Build.VERSION.SDK_INT >= 30) {\n            wm.currentWindowMetrics   // placeholder \u2014 real call below\n            context.display?.refreshRate?.toInt() ?: 60\n        } else {\n            @Suppress(\"DEPRECATION\")\n            wm.defaultDisplay.refreshRate.toInt()\n        }\n    }\n\n    private fun estimateTouchHz(displayHz: Int): Int = when {\n        displayHz >= 144 -> 240\n        displayHz >= 120 -> 180\n        displayHz >= 90  -> 120\n        else             -> 60\n    }\n\n    private fun detectSoC(cpuInfo: String): String {\n        val board = Build.BOARD.uppercase()\n        return when {\n            \"TARO\"   in board -> \"Snapdragon 8 Gen 1\"\n            \"KALAMA\" in board -> \"Snapdragon 8 Gen 2\"\n            \"PINEAPPLE\" in board -> \"Snapdragon 8 Gen 3\"\n            \"TENSOR\" in Build.HARDWARE.uppercase() -> \"Google Tensor\"\n            cpuInfo.contains(\"Dimensity\", ignoreCase = true) -> \"MediaTek Dimensity\"\n            else -> \"${Build.HARDWARE} / ${Build.BOARD}\"\n        }\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/core/ThermalGuardian.kt", "content": "package com.nexcore.optimizer.core\n\nimport android.content.Context\nimport android.os.Vibrator\nimport android.os.VibrationEffect\nimport android.os.Build\nimport kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.SupervisorJob\nimport kotlinx.coroutines.delay\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport kotlinx.coroutines.launch\nimport java.io.File\n\n/**\n * Thermal Guardian \u2014 polls /sys thermal zones every [intervalMs] ms.\n *\n * Thresholds (\u00b0C):\n *   NORMAL   < 42   \u2192 no action\n *   WARM     42\u201345  \u2192 log, standby\n *   HOT      45\u201350  \u2192 switch AdaptivePerformance to BALANCED\n *   CRITICAL > 50   \u2192 switch to POWERSAVE + vibrate alert\n *\n * Thermal zone paths vary by SoC:\n *   Snapdragon: /sys/class/thermal/thermal_zone[0-9]/temp (millidegrees)\n *   Dimensity : /sys/class/thermal/thermal_zone[0-9]/temp (degrees)\n */\nclass ThermalGuardian(\n    private val context: Context,\n    private val shizuku: ShizukuManager,\n    private val perf   : AdaptivePerformance\n) {\n    enum class State { NORMAL, WARM, HOT, CRITICAL }\n\n    data class Reading(val zoneName: String, val tempC: Float)\n\n    private val scope  = CoroutineScope(SupervisorJob() + Dispatchers.IO)\n    private val _state = MutableStateFlow(State.NORMAL)\n    val state: StateFlow<State> = _state.asStateFlow()\n\n    private val _readings = MutableStateFlow<List<Reading>>(emptyList())\n    val readings: StateFlow<List<Reading>> = _readings.asStateFlow()\n\n    companion object {\n        const val WARM_C     = 42f\n        const val HOT_C      = 45f\n        const val CRITICAL_C = 50f\n    }\n\n    fun start(intervalMs: Long = 2000L) {\n        scope.launch {\n            while (true) {\n                val zones = readAllZones()\n                _readings.value = zones\n                val peak = zones.maxOfOrNull { it.tempC } ?: 0f\n                val newState = when {\n                    peak >= CRITICAL_C -> State.CRITICAL\n                    peak >= HOT_C      -> State.HOT\n                    peak >= WARM_C     -> State.WARM\n                    else               -> State.NORMAL\n                }\n                if (newState != _state.value) {\n                    onStateChange(newState, peak)\n                    _state.value = newState\n                }\n                delay(intervalMs)\n            }\n        }\n        Blackbox.log(\"THERMAL\", \"Guardian started \u2014 polling every ${intervalMs}ms\")\n    }\n\n    private fun readAllZones(): List<Reading> {\n        val results = mutableListOf<Reading>()\n        for (i in 0..15) {\n            val typePath = \"/sys/class/thermal/thermal_zone$i/type\"\n            val tempPath = \"/sys/class/thermal/thermal_zone$i/temp\"\n            try {\n                val type = File(typePath).readText().trim()\n                val raw  = File(tempPath).readText().trim().toFloatOrNull() ?: continue\n                // Snapdragon reports millidegrees; check if value > 1000 \u2192 divide by 1000\n                val tempC = if (raw > 1000f) raw / 1000f else raw\n                results += Reading(type, tempC)\n            } catch (_: Exception) { }\n        }\n        return results\n    }\n\n    private fun onStateChange(new: State, peakC: Float) {\n        Blackbox.log(\n            \"THERMAL\",\n            \"State ${_state.value.name} \u2192 ${new.name} \u00b7 peak=${peakC}\u00b0C\",\n            if (new >= State.HOT) Blackbox.Level.WARN else Blackbox.Level.OK\n        )\n        when (new) {\n            State.HOT      -> perf.apply(AdaptivePerformance.Profile.BALANCED)\n            State.CRITICAL -> {\n                perf.apply(AdaptivePerformance.Profile.POWERSAVE)\n                vibrate()\n            }\n            State.NORMAL   -> perf.apply(AdaptivePerformance.Profile.BALANCED)\n            State.WARM     -> { /* log only */ }\n        }\n    }\n\n    private fun vibrate() {\n        val v = context.getSystemService(Context.VIBRATOR_SERVICE) as? Vibrator ?: return\n        if (Build.VERSION.SDK_INT >= 26) {\n            v.vibrate(VibrationEffect.createOneShot(400, VibrationEffect.DEFAULT_AMPLITUDE))\n        } else {\n            @Suppress(\"DEPRECATION\")\n            v.vibrate(400)\n        }\n    }\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/service/GameDetectorService.kt", "content": "package com.nexcore.optimizer.service\n\nimport android.app.Notification\nimport android.app.NotificationChannel\nimport android.app.NotificationManager\nimport android.app.Service\nimport android.app.usage.UsageStatsManager\nimport android.content.Context\nimport android.content.Intent\nimport android.os.IBinder\nimport com.nexcore.optimizer.core.*\nimport kotlinx.coroutines.*\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\n\n/**\n * GameDetectorService \u2014 foreground service that polls UsageStats every [POLL_MS] ms\n * to detect when a monitored game enters the foreground.\n *\n * On game launch:\n *   1. Apply the game's SensitivityManager profile\n *   2. Apply the NeuralEngine-recommended AdaptivePerformance profile\n *   3. Apply the recommended SmartDPI\n *   4. Acquire WiFi lock (NetworkIntelligence)\n *   5. Start Aftermatch session\n *\n * On game exit:\n *   1. End Aftermatch session\n *   2. Release WiFi lock\n *   3. Reset to BALANCED performance\n *   4. Optionally reset DPI (configurable)\n *\n * Requires PACKAGE_USAGE_STATS permission \u2014 user must grant via Settings.\n * This permission cannot be granted via Shizuku; it needs Settings \u2192 Apps \u2192 Special access.\n */\nclass GameDetectorService : Service() {\n\n    companion object {\n        private const val POLL_MS         = 500L\n        private const val CHANNEL_ID      = \"nexcore_fg\"\n        private const val NOTIF_ID        = 1\n        private const val SAMPLE_INTERVAL = 1000L   // ms between Aftermatch samples\n\n        /** Package names to watch. Extend via Settings in the app. */\n        val MONITORED_PACKAGES = setOf(\n            \"com.mobile.legends\",\n            \"com.dts.freefireth\",\n            \"com.tencent.ig\",\n            \"com.activision.callofduty.shooter\",\n            \"com.garena.game.codm\",\n            \"com.pearlabyss.blackdesertm\"\n        )\n\n        val GAME_LABELS = mapOf(\n            \"com.mobile.legends\"                -> \"Mobile Legends\",\n            \"com.dts.freefireth\"               -> \"Free Fire\",\n            \"com.tencent.ig\"                   -> \"PUBG Mobile\",\n            \"com.activision.callofduty.shooter\" -> \"COD Mobile\",\n            \"com.garena.game.codm\"             -> \"COD Mobile (Garena)\",\n            \"com.pearlabyss.blackdesertm\"       -> \"Black Desert Mobile\"\n        )\n\n        private val _foregroundGame = MutableStateFlow<String?>(null)\n        val foregroundGame: StateFlow<String?> = _foregroundGame.asStateFlow()\n    }\n\n    private val scope      = CoroutineScope(SupervisorJob() + Dispatchers.IO)\n    private lateinit var shizuku   : ShizukuManager\n    private lateinit var sensi     : SensitivityManager\n    private lateinit var dpi       : SmartDPI\n    private lateinit var perf      : AdaptivePerformance\n    private lateinit var neural    : NeuralEngine\n    private lateinit var aftermatch: Aftermatch\n    private lateinit var net       : NetworkIntelligence\n    private lateinit var thermal   : ThermalGuardian\n\n    private var activeGame: String? = null\n\n    override fun onCreate() {\n        super.onCreate()\n        shizuku    = ShizukuManager(this).also   { it.init() }\n        perf       = AdaptivePerformance(shizuku)\n        sensi      = SensitivityManager(this, shizuku)\n        dpi        = SmartDPI(this, shizuku)\n        net        = NetworkIntelligence(this, shizuku)\n        thermal    = ThermalGuardian(this, shizuku, perf).also { it.start() }\n        aftermatch = Aftermatch()\n\n        // NeuralEngine needs DeviceDNA \u2014 build it once\n        val scan   = SmartScan(this, shizuku)\n        val dnaBld = DeviceDNA(scan)\n        val dnaProfile = dnaBld.build()\n        neural = NeuralEngine(perf, thermal, net, dnaBld).also { it.init(dnaProfile) }\n\n        startForeground(NOTIF_ID, buildNotification(\"Watching for games\u2026\"))\n        Blackbox.log(\"SERVICE\", \"GameDetectorService created \u00b7 watching ${MONITORED_PACKAGES.size} packages\")\n    }\n\n    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {\n        startDetectionLoop()\n        return START_STICKY\n    }\n\n    private fun startDetectionLoop() {\n        scope.launch {\n            val usm = getSystemService(Context.USAGE_STATS_SERVICE) as UsageStatsManager\n            var sampleTick = 0L\n\n            while (isActive) {\n                val now    = System.currentTimeMillis()\n                val stats  = usm.queryUsageStats(\n                    UsageStatsManager.INTERVAL_DAILY,\n                    now - 5_000L, now\n                )\n                val current = stats\n                    ?.filter { it.packageName in MONITORED_PACKAGES }\n                    ?.maxByOrNull  { it.lastTimeUsed }\n                    ?.takeIf       { now - it.lastTimeUsed < POLL_MS * 3 }\n                    ?.packageName\n\n                when {\n                    current != null && current != activeGame -> onGameStart(current)\n                    current == null && activeGame != null    -> onGameStop()\n                }\n\n                // Aftermatch sampling\n                if (activeGame != null && now - sampleTick >= SAMPLE_INTERVAL) {\n                    sampleTick = now\n                    val tempC = thermal.readings.value\n                        .firstOrNull { \"cpu\" in it.zoneName.lowercase() }?.tempC ?: 0f\n                    aftermatch.sample(fps = 60f, tempC = tempC, pingMs = net.ping())\n                }\n\n                delay(POLL_MS)\n            }\n        }\n    }\n\n    private suspend fun onGameStart(pkg: String) {\n        activeGame = pkg\n        _foregroundGame.value = pkg\n        val label = GAME_LABELS[pkg] ?: pkg\n\n        Blackbox.log(\"GAME\", \"$label detected foreground\")\n        updateNotification(\"\u25b6 $label\")\n\n        // 1. Sensitivity\n        sensi.applyForGame(pkg)\n\n        // 2. Performance + DPI from NeuralEngine\n        val rec = neural.recommend(pkg)\n        perf.apply(rec.perfProfile)\n        dpi.apply(rec.dpiTarget)\n\n        // 3. Network\n        net.acquireWifiLock(\"NexCore:$pkg\")\n        net.setGameDns()\n\n        // 4. Session\n        aftermatch.startSession(pkg, label, rec.perfProfile.name, rec.dpiTarget)\n\n        // 5. Neural rescore with all modules active\n        neural.recompute(activeModules = 5)\n    }\n\n    private fun onGameStop() {\n        val pkg   = activeGame ?: return\n        val label = GAME_LABELS[pkg] ?: pkg\n        activeGame = null\n        _foregroundGame.value = null\n\n        Blackbox.log(\"GAME\", \"$label left foreground\")\n        updateNotification(\"Watching for games\u2026\")\n\n        aftermatch.endSession()\n        net.releaseWifiLock()\n        perf.apply(AdaptivePerformance.Profile.BALANCED)\n    }\n\n    private fun buildNotification(text: String): Notification {\n        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager\n        nm.createNotificationChannel(\n            NotificationChannel(CHANNEL_ID, \"NexCore\", NotificationManager.IMPORTANCE_LOW)\n        )\n        return Notification.Builder(this, CHANNEL_ID)\n            .setContentTitle(\"NexCore\")\n            .setContentText(text)\n            .setSmallIcon(android.R.drawable.ic_media_play)\n            .build()\n    }\n\n    private fun updateNotification(text: String) {\n        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager\n        nm.notify(NOTIF_ID, buildNotification(text))\n    }\n\n    override fun onDestroy() {\n        scope.cancel()\n        shizuku.destroy()\n        super.onDestroy()\n    }\n\n    override fun onBind(intent: Intent?): IBinder? = null\n}"}, {"path": "app/src/main/java/com/nexcore/optimizer/service/NexCoreUserService.kt", "content": "package com.nexcore.optimizer.service\n\nimport android.os.IBinder\nimport android.util.Log\nimport java.io.File\n\n/**\n * Shizuku UserService \u2014 runs in a separate process with shell UID (uid=2000).\n *\n * Shizuku starts this service via its privileged helper and exposes it to the\n * main app process over an AIDL binder. All methods here execute with the\n * permissions of the shell user, which allows:\n *   - Writing to /sys paths the app cannot reach\n *   - Running `wm density`, `settings put secure`, `ndc`, etc.\n *   - Reading /proc files restricted to uid\u22650 but not to app sandbox\n *\n * Keep this class minimal \u2014 heavy logic lives in the core/ layer of the app process.\n */\nclass NexCoreUserService : IUserService.Stub() {\n\n    companion object {\n        private const val TAG = \"NexCoreService\"\n    }\n\n    override fun executeCommand(cmd: String): String {\n        Log.d(TAG, \"exec: $cmd\")\n        return try {\n            val p   = Runtime.getRuntime().exec(arrayOf(\"sh\", \"-c\", cmd))\n            val out = p.inputStream.bufferedReader().readText()\n            val err = p.errorStream.bufferedReader().readText()\n            p.waitFor()\n            if (err.isNotBlank()) Log.w(TAG, \"stderr: $err\")\n            (out + err).trim()\n        } catch (e: Exception) {\n            Log.e(TAG, \"exec failed: ${e.message}\")\n            \"Error: ${e.message}\"\n        }\n    }\n\n    override fun readFile(path: String): String {\n        return try {\n            File(path).readText()\n        } catch (e: Exception) {\n            \"Error: ${e.message}\"\n        }\n    }\n\n    override fun writeFile(path: String, content: String): Boolean {\n        return try {\n            File(path).writeText(content)\n            true\n        } catch (e: Exception) {\n            Log.e(TAG, \"writeFile $path: ${e.message}\")\n            false\n        }\n    }\n\n    override fun destroy() {\n        Log.d(TAG, \"Service destroyed\")\n    }\n\n    // Required by Shizuku \u2014 return this binder from the service's onBind\n    fun asBinder(): IBinder = this\n}"}];
const TOTAL = FILES.length;

function log(msg, cls='info') {
  const el = document.getElementById('log');
  el.style.display = 'block';
  el.innerHTML += `<div class="${cls}">${msg}</div>`;
  el.scrollTop = el.scrollHeight;
}

function setProgress(done) {
  const pct = Math.round(done / TOTAL * 100);
  document.getElementById('bar').style.width = pct + '%';
  document.getElementById('bar-label').textContent = done + ' / ' + TOTAL + ' (' + pct + '%)';
}

async function uploadFile(token, owner, repo, path, content, retries=2) {
  const url = `https://api.github.com/repos/${owner}/${repo}/contents/${path}`;
  const b64  = btoa(unescape(encodeURIComponent(content)));

  // Check if file exists (to get SHA for update)
  let sha = undefined;
  try {
    const chk = await fetch(url, {headers:{'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json'}});
    if (chk.ok) { const j = await chk.json(); sha = j.sha; }
  } catch(_) {}

  const body = {message: 'add ' + path, content: b64};
  if (sha) body.sha = sha;

  for (let i = 0; i <= retries; i++) {
    const r = await fetch(url, {
      method: 'PUT',
      headers: {'Authorization':'Bearer '+token,'Content-Type':'application/json','Accept':'application/vnd.github+json'},
      body: JSON.stringify(body)
    });
    if (r.status === 200 || r.status === 201) return true;
    if (i < retries) await new Promise(r => setTimeout(r, 800));
  }
  return false;
}

async function startUpload() {
  const token = document.getElementById('token').value.trim();
  const owner = document.getElementById('owner').value.trim();
  const repo  = document.getElementById('repo').value.trim();

  if (!token || !owner || !repo) { alert('Isi semua field dulu!'); return; }

  const btn = document.getElementById('btn');
  btn.disabled = true;
  btn.textContent = 'Uploading...';
  document.getElementById('progress').style.display = 'block';
  document.getElementById('result').style.display = 'none';

  log(`Mulai upload ke ${owner}/${repo}...`, 'info');

  let ok = 0, fail = 0, failList = [];

  for (let i = 0; i < FILES.length; i++) {
    const f = FILES[i];
    log(`[${i+1}/${TOTAL}] ${f.path}`, 'info');
    const success = await uploadFile(token, owner, repo, f.path, f.content);
    if (success) { ok++; log('  ✓ OK', 'ok'); }
    else { fail++; failList.push(f.path); log('  ✗ GAGAL', 'err'); }
    setProgress(i + 1);
    // small delay to avoid rate limit
    await new Promise(r => setTimeout(r, 300));
  }

  btn.disabled = false;
  btn.textContent = '⬆ Upload Selesai';

  const res = document.getElementById('result');
  res.style.display = 'block';
  if (fail === 0) {
    res.className = 'result success';
    res.innerHTML = `✅ Semua ${ok} file berhasil diupload!<br><br><b>Langkah selanjutnya:</b><br>Buka repo → tab <b>Actions</b> → <b>Run workflow</b> → tunggu ~5 menit → download APK dari Artifacts`;
  } else {
    res.className = 'result failed';
    res.innerHTML = `⚠️ ${ok} berhasil, ${fail} gagal:<br>${failList.join('<br>')}`;
  }
}
</script>
</body>
</html>